/* =====================================================
   PAINEL LATERAL ADMINISTRATIVO — VERSÃO FINAL
   Cole este bloco no FINAL de desktop/estilos/admin.qss
   ===================================================== */

QFrame#painelDetalhesAdmin {
    background-color: #ffffff;
    border: 1px solid #d5e0e8;
    border-radius: 13px;
}

QLabel#tituloPainelAdmin {
    color: #10263b;
    background-color: transparent;
    border: none;
    font-size: 17px;
    font-weight: 800;
    padding: 0px;
    margin: 0px;
}

QLabel#nomePainelAdmin {
    color: #10263b;
    background-color: transparent;
    border: none;
    font-size: 16px;
    font-weight: 800;
    padding: 1px 0px;
    margin: 0px;
}

QLabel#textoPainelAdmin {
    color: #62778a;
    background-color: transparent;
    border: none;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}

QLabel#linhaPainelAdmin {
    color: #29465e;
    background-color: #f5f8fa;
    border: 1px solid #dde6ec;
    border-radius: 7px;
    font-size: 12px;
    padding: 7px 10px;
    margin: 0px;
}


/* =====================================================
   GERENCIAR PRODUTOS
   ===================================================== */

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin {
    background-color: #ffffff;
    border: 1px solid #d5e0e8;
    border-radius: 13px;
}

QWidget#paginaAdminProdutos QLabel#tituloPainelAdmin {
    font-size: 17px;
    font-weight: 800;
}

QWidget#paginaAdminProdutos QLabel#imagemPainelAdmin {
    color: #718394;
    background-color: #f3f6f8;
    border: 1px solid #dce5eb;
    border-radius: 9px;
    padding: 5px;
    margin: 0px 0px 2px 0px;
}

QWidget#paginaAdminProdutos QLabel#nomePainelAdmin {
    color: #10263b;
    background-color: transparent;
    border: none;
    font-size: 16px;
    font-weight: 800;
    padding: 1px 0px;
    margin: 0px;
}

QWidget#paginaAdminProdutos QLabel#textoPainelAdmin {
    color: #617689;
    background-color: transparent;
    border: none;
    font-size: 12px;
    padding: 0px;
    margin: 0px;
}

QWidget#paginaAdminProdutos QLabel#linhaPainelAdmin {
    color: #29465e;
    background-color: #f5f8fa;
    border: 1px solid #dde6ec;
    border-radius: 7px;
    font-size: 12px;
    padding: 7px 10px;
    margin: 0px;
}

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin QPushButton {
    min-height: 40px;
    max-height: 40px;
    border-radius: 7px;
    padding: 0px 12px;
    font-size: 12px;
    font-weight: 650;
}

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin QPushButton#botaoPrimario {
    color: #ffffff;
    background-color: #173b5b;
    border: 1px solid #173b5b;
}

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin QPushButton#botaoPrimario:hover {
    background-color: #102f49;
    border-color: #102f49;
}

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin QPushButton#botaoPerigo {
    color: #b3313a;
    background-color: #ffffff;
    border: 1px solid #e2a7ab;
}

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin QPushButton#botaoPerigo:hover {
    color: #ffffff;
    background-color: #b93f48;
    border-color: #b93f48;
}

QWidget#paginaAdminProdutos QFrame#painelDetalhesAdmin QPushButton:disabled {
    color: #8c98a2;
    background-color: #edf1f4;
    border-color: #d8e0e5;
}


/* =====================================================
   GERENCIAR MÉDICOS
   ===================================================== */

QWidget#paginaAdminMedicos QLabel#imagemPainelAdmin {
    color: #718394;
    background-color: #f3f6f8;
    border: 1px solid #dce5eb;
    border-radius: 10px;
    padding: 6px;
}

QWidget#paginaAdminMedicos QLabel#nomePainelAdmin {
    color: #10263b;
    background-color: transparent;
    border: none;
    font-size: 16px;
    font-weight: 800;
    padding: 2px 0px;
}

QWidget#paginaAdminMedicos QLabel#linhaPainelAdmin {
    color: #29465e;
    background-color: #f5f8fa;
    border: 1px solid #dde6ec;
    border-radius: 7px;
    font-size: 12px;
    padding: 8px 10px;
}

QWidget#paginaAdminMedicos QFrame#painelDetalhesAdmin QPushButton {
    min-height: 42px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 650;
}

QWidget#paginaAdminMedicos QFrame#painelDetalhesAdmin QPushButton#botaoPrimario {
    color: #ffffff;
    background-color: #173b5b;
    border: 1px solid #173b5b;
}

QWidget#paginaAdminMedicos QFrame#painelDetalhesAdmin QPushButton#botaoPrimario:hover {
    background-color: #102f49;
    border-color: #102f49;
}

QWidget#paginaAdminMedicos QFrame#painelDetalhesAdmin QPushButton#botaoPerigo {
    color: #b3313a;
    background-color: #ffffff;
    border: 1px solid #e2a7ab;
}

QWidget#paginaAdminMedicos QFrame#painelDetalhesAdmin QPushButton#botaoPerigo:hover {
    color: #ffffff;
    background-color: #b93f48;
    border-color: #b93f48;
}

QWidget#paginaAdminProdutos,
QWidget#paginaAdminMedicos,
QWidget#paginaAdminPedidos,
QWidget#paginaAdminConsultas {
    background-color: #f4f6f8;
}

QLabel#tituloPaginaAdmin,
QLabel#tituloDialogAdmin {
    color: #10263b;
    font-size: 23px;
    font-weight: 800;
}

QLabel#subtituloPaginaAdmin,
QLabel#textoAuxiliarAdmin {
    color: #687887;
    font-size: 12px;
}

QLabel#avisoAdmin {
    padding: 12px;
    color: #7a5a16;
    background-color: #fff8e7;
    border: 1px solid #ead6a8;
    border-radius: 9px;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafb;
    border: 1px solid #e1e7ec;
    border-radius: 12px;
    gridline-color: #edf1f4;
    selection-background-color: #dcefeb;
    selection-color: #10263b;
}

QHeaderView::section {
    padding: 10px;
    color: #ffffff;
    background-color: #17344f;
    border: none;
    font-weight: 700;
}

QDialog {
    background-color: #f8fafb;
}

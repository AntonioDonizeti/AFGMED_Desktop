/* =====================================================
   TELA MÉDICA — MINHAS CONSULTAS
   VERSÃO MAIS LIMPA E COMPACTA
   ===================================================== */

QWidget#paginaConsultasMedico {
    background-color: #f4f6f8;
}

QWidget#paginaConsultasMedico QLabel#tituloPagina {
    color: #10263b;
    font-size: 24px;
    font-weight: 800;
}

QWidget#paginaConsultasMedico QLabel#subtituloPagina {
    color: #64788a;
    font-size: 12px;
}

QLineEdit#campoBuscaConsultasMedico {
    min-width: 290px;
    min-height: 42px;
    background-color: #ffffff;
    border: 1px solid #cbd7df;
    border-radius: 8px;
    padding: 0px 12px;
}

QWidget#paginaConsultasMedico QComboBox {
    min-height: 42px;
    min-width: 105px;
    background-color: #ffffff;
    border: 1px solid #cbd7df;
    border-radius: 8px;
    padding: 0px 10px;
}

QWidget#paginaConsultasMedico QPushButton {
    min-height: 42px;
    border-radius: 8px;
    padding: 0px 16px;
    font-weight: 650;
}


/* =====================================================
   RESUMO
   ===================================================== */

QFrame#resumoConsultasMedico {
    background-color: #ffffff;
    border: 1px solid #d9e3ea;
    border-radius: 12px;
}

QFrame#metricaConsultaMedico {
    background-color: #f7f9fb;
    border: 1px solid #dfe7ec;
    border-radius: 9px;
}

QFrame#metricaConsultaMedico[tipoMetrica="hoje"] {
    border-left: 4px solid #357fc1;
}

QFrame#metricaConsultaMedico[tipoMetrica="agendada"] {
    border-left: 4px solid #20857e;
}

QFrame#metricaConsultaMedico[tipoMetrica="concluida"] {
    border-left: 4px solid #667d8e;
}

QFrame#metricaConsultaMedico[tipoMetrica="cancelada"] {
    border-left: 4px solid #c04e57;
}

QLabel#rotuloMetricaConsulta {
    color: #6c7f90;
    font-size: 11px;
}

QLabel#valorMetricaConsulta {
    color: #10263b;
    font-size: 22px;
    font-weight: 800;
}


/* =====================================================
   TABELA
   ===================================================== */

QTableWidget#tabelaConsultasMedico {
    background-color: #ffffff;
    alternate-background-color: #f6f8fa;
    border: 1px solid #d8e2e9;
    border-radius: 11px;
    gridline-color: #e2e8ed;
    selection-background-color: #dcecf2;
    selection-color: #10263b;
    outline: none;
}

QTableWidget#tabelaConsultasMedico::item {
    padding: 7px 9px;
    color: #20384d;
}

QTableWidget#tabelaConsultasMedico::item:selected {
    background-color: #dcecf2;
    color: #10263b;
}

QTableWidget#tabelaConsultasMedico QHeaderView::section {
    color: #ffffff;
    background-color: #173b5b;
    border: none;
    border-right: 1px solid #2d5675;
    padding: 10px 8px;
    font-size: 12px;
    font-weight: 700;
}


/* =====================================================
   PAINEL LATERAL
   ===================================================== */

QFrame#painelDetalhesConsultaMedico {
    background-color: #ffffff;
    border: 1px solid #d5e0e8;
    border-radius: 12px;
}

QLabel#tituloPainelConsultaMedico {
    color: #10263b;
    font-size: 16px;
    font-weight: 800;
}

QLabel#nomePacienteConsultaMedico {
    color: #10263b;
    font-size: 17px;
    font-weight: 800;
    padding: 2px 0px 4px 0px;
}

QLabel#statusConsultaMedico {
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#statusConsultaMedico[tipoStatus="agendada"] {
    color: #285575;
    background-color: #eef5fa;
    border: 1px solid #bfd4e4;
}

QLabel#statusConsultaMedico[tipoStatus="concluida"] {
    color: #19553e;
    background-color: #eef8f3;
    border: 1px solid #b9ddcc;
}

QLabel#statusConsultaMedico[tipoStatus="cancelada"] {
    color: #7d2f35;
    background-color: #fbf0f1;
    border: 1px solid #e5bdc0;
}

QLabel#statusConsultaMedico[tipoStatus="nenhum"] {
    color: #697b8b;
    background-color: #f4f6f8;
    border: 1px solid #dfe5ea;
}

QLabel#linhaDetalheConsultaMedico {
    color: #29465e;
    background-color: #f6f8fa;
    border: 1px solid #dfe7ec;
    border-radius: 7px;
    padding: 6px 9px;
    font-size: 11px;
}

QLabel#avisoConsultaMedico {
    color: #65798a;
    background-color: transparent;
    border: none;
    font-size: 11px;
    padding: 2px 0px;
}

QPushButton#botaoConcluirConsultaMedico {
    min-height: 40px;
    max-height: 40px;
    color: #ffffff;
    background-color: #1b817a;
    border: 1px solid #1b817a;
    border-radius: 7px;
    font-weight: 700;
}

QPushButton#botaoConcluirConsultaMedico:hover {
    background-color: #146b65;
    border-color: #146b65;
}


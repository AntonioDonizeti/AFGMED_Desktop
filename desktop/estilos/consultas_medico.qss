QWidget#paginaConsultasMedico {
    background-color: #f4f6f8;
}

QLabel#tituloPagina {
    color: #10263b;
    font-size: 23px;
    font-weight: 800;
}

QLabel#subtituloPagina {
    color: #687887;
    font-size: 13px;
}

QFrame#resumoConsultasMedico {
    background-color: #ffffff;
    border: 1px solid #e2e8ed;
    border-radius: 13px;
}

QFrame#metricaConsultaMedico {
    min-width: 125px;
    background-color: #f8fafb;
    border: 1px solid #e6ebef;
    border-radius: 10px;
}

QLabel#rotuloMetricaConsulta {
    color: #6d7c8b;
    font-size: 11px;
    font-weight: 650;
}

QLabel#valorMetricaConsulta {
    color: #17344f;
    font-size: 22px;
    font-weight: 850;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafb;
    border: 1px solid #e1e7ec;
    border-radius: 12px;
    gridline-color: #edf1f4;
    selection-background-color: #dcefeb;
    selection-color: #10263b;
}

QHeaderView::section {
    padding: 10px;
    color: #ffffff;
    background-color: #17344f;
    border: none;
    font-weight: 700;
}

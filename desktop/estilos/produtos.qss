QWidget#paginaProdutos {
    background-color: #f4f6f8;
}

QLabel#tituloPagina {
    color: #10263b;
    font-size: 25px;
    font-weight: 800;
}

QLabel#subtituloPagina {
    color: #617080;
    font-size: 14px;
}

QFrame#produtoCard {
    background-color: #ffffff;
    border: 1px solid #e8edf1;
    border-radius: 14px;
}

QFrame#areaImagem {
    background-color: #f6f8fa;
    border: 1px solid #e8edf1;
    border-radius: 10px;
}

QLabel#fotoProduto {
    color: #7b8794;
}

QLabel#nomeProduto {
    color: #10263b;
    font-size: 18px;
    font-weight: 800;
}

QLabel#descricaoProduto {
    color: #617080;
    font-size: 13px;
}

QLabel#badgeDisponivel,
QLabel#badgePoucoEstoque,
QLabel#badgeSemEstoque {
    padding: 5px 9px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#badgeDisponivel {
    color: #19553e;
    background-color: #eef8f3;
    border: 1px solid #b9ddcc;
}

QLabel#badgePoucoEstoque {
    color: #765019;
    background-color: #fff7e8;
    border: 1px solid #ead3a7;
}

QLabel#badgeSemEstoque {
    color: #7d2f35;
    background-color: #fbf0f1;
    border: 1px solid #e5bdc0;
}

QFrame#painelPreco {
    background-color: #f6f8fa;
    border: 1px solid #e8edf1;
    border-radius: 9px;
}

QLabel#rotuloPreco {
    color: #7b8794;
    font-size: 11px;
}

QLabel#valorProduto {
    color: #176f6a;
    font-size: 21px;
    font-weight: 800;
}

QLabel#textoEstoque {
    color: #465564;
    font-size: 12px;
    font-weight: 650;
}

QPushButton#botaoComprar {
    min-height: 44px;
    color: #ffffff;
    background-color: #176f6a;
    border-color: #176f6a;
    font-weight: 750;
}

QPushButton#botaoComprar:hover {
    background-color: #125e5a;
    border-color: #125e5a;
}

QLabel#mensagemVazia {
    color: #617080;
    font-size: 16px;
    padding: 45px;
}

QLabel#mensagemErro {
    color: #a93f46;
    font-size: 14px;
    padding: 35px;
}

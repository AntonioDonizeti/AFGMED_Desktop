/* Cards resumidos */
QWidget#containerPedidos {
    background-color: transparent;
}

QFrame#pedidoResumoCard {
    background-color: #ffffff;
    border: 1px solid #dce5ec;
    border-radius: 14px;
}

QFrame#pedidoResumoCard:hover {
    border: 1px solid #b9cbd8;
    background-color: #fcfdfe;
}

QLabel#numeroPedidoResumo {
    color: #10263b;
    font-size: 15px;
    font-weight: 750;
}

QLabel#dataPedidoResumo {
    color: #75889a;
    font-size: 12px;
}

QFrame#areaImagemPedidoResumo {
    background-color: #f5f8fa;
    border: 1px solid #e1e8ed;
    border-radius: 11px;
}

QLabel#imagemPedidoClicavel {
    color: #748596;
    font-size: 12px;
}

QLabel#dicaImagemPedido {
    color: #6f8293;
    font-size: 11px;
}

QLabel#produtoPrincipalPedido {
    color: #10263b;
    font-size: 16px;
    font-weight: 750;
}

QLabel#resumoItensPedido,
QLabel#localEntregaResumo,
QLabel#descricaoStatusResumo {
    color: #607588;
    font-size: 12px;
}

QLabel#totalPedidoResumo {
    color: #123f63;
    font-size: 22px;
    font-weight: 800;
}

/* Status */
QLabel#statusPedido {
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#statusPedido[tipoStatus="aprovado"] {
    color: #17603f;
    background-color: #edf8f2;
    border: 1px solid #b5dcc9;
}

QLabel#statusPedido[tipoStatus="pendente"] {
    color: #76520b;
    background-color: #fff8e8;
    border: 1px solid #ead39b;
}

QLabel#statusPedido[tipoStatus="falha"] {
    color: #8b3038;
    background-color: #fff1f2;
    border: 1px solid #efc1c5;
}

QLabel#statusPedido[tipoStatus="analise"] {
    color: #4e5f70;
    background-color: #f1f4f6;
    border: 1px solid #ccd6dd;
}

/* Janela de detalhes */
QDialog#dialogDetalhesPedido {
    background-color: #f3f6f8;
}

QFrame#cabecalhoDetalhesPedido,
QFrame#painelDetalhePedido,
QFrame#painelTotaisDetalhes,
QFrame#itemDetalhesPedido {
    background-color: #ffffff;
    border: 1px solid #dce5ec;
    border-radius: 11px;
}

QLabel#tituloDetalhesPedido {
    color: #10263b;
    font-size: 21px;
    font-weight: 800;
}

QLabel#dataDetalhesPedido,
QLabel#descricaoDetalhesPedido,
QLabel#textoAuxiliarPedido {
    color: #65798b;
    font-size: 12px;
}

QLabel#subtituloDetalhesPedido {
    color: #10263b;
    font-size: 16px;
    font-weight: 750;
}

QLabel#fotoItemDetalhesPedido {
    background-color: #f5f8fa;
    border: 1px solid #e1e8ed;
    border-radius: 8px;
}

QLabel#nomeItemDetalhesPedido {
    color: #10263b;
    font-size: 14px;
    font-weight: 750;
}

QLabel#descricaoItemDetalhesPedido {
    color: #64798b;
    font-size: 12px;
}

QLabel#subtotalItemDetalhesPedido {
    color: #173f63;
    font-size: 14px;
    font-weight: 750;
}

QLabel#rotuloDetalhePedido,
QLabel#rotuloTotalDetalhes,
QLabel#rotuloTotalDestaque {
    color: #607588;
    font-size: 12px;
    font-weight: 700;
}

QLabel#valorDetalhePedido,
QLabel#valorTotalDetalhes {
    color: #17344f;
    font-size: 13px;
}

QLabel#valorTotalDestaque {
    color: #123f63;
    font-size: 19px;
    font-weight: 800;
}

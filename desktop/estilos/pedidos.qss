QWidget#paginaPedidos {
    background-color: #f4f6f8;
}

QLabel#tituloPagina {
    color: #10263b;
    font-size: 25px;
    font-weight: 800;
}

QLabel#subtituloPagina {
    color: #617080;
}

QFrame#pedidoCard {
    background-color: #ffffff;
    border: 1px solid #e8edf1;
    border-radius: 13px;
}

QLabel#numeroPedido {
    color: #10263b;
    font-size: 18px;
    font-weight: 800;
}

QLabel#dataPedido,
QLabel#enderecoPedido {
    color: #617080;
    font-size: 12px;
}

QLabel#statusPedido {
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 750;
}

QLabel#statusPedido[tipoStatus="aprovado"] {
    color: #19553e;
    background-color: #eef8f3;
    border: 1px solid #b9ddcc;
}

QLabel#statusPedido[tipoStatus="pendente"] {
    color: #765019;
    background-color: #fff7e8;
    border: 1px solid #ead3a7;
}

QLabel#statusPedido[tipoStatus="falha"] {
    color: #7d2f35;
    background-color: #fbf0f1;
    border: 1px solid #e5bdc0;
}

QLabel#statusPedido[tipoStatus="analise"] {
    color: #285575;
    background-color: #eef5fa;
    border: 1px solid #bfd4e4;
}

QFrame#linhaProdutoPedido {
    background-color: #f6f8fa;
    border: 1px solid #e8edf1;
    border-radius: 8px;
}

QLabel#nomeProdutoPedido {
    color: #10263b;
    font-weight: 700;
}

QLabel#detalheProdutoPedido {
    color: #617080;
    font-size: 12px;
}

QLabel#subtotalProdutoPedido {
    color: #10263b;
    font-weight: 750;
}

QLabel#totalPedido {
    color: #10263b;
    font-size: 20px;
    font-weight: 800;
}

QLabel#pedidosVazio {
    color: #617080;
    font-size: 16px;
    padding: 50px;
}

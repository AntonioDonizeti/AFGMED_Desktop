QWidget {
    color: #2c3946;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow,
QDialog,
QWidget#paginaRaiz {
    background-color: #f4f6f8;
}

QLabel {
    background-color: transparent;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QLineEdit,
QDateEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    min-height: 38px;
    padding: 4px 10px;
    color: #1c2733;
    background-color: #ffffff;
    border: 1px solid #cbd3da;
    border-radius: 8px;
    selection-background-color: #1c817a;
    selection-color: #ffffff;
}

QLineEdit:hover,
QDateEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #aeb9c3;
}

QLineEdit:focus,
QDateEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #1c817a;
}

QLineEdit:read-only {
    color: #617080;
    background-color: #edf1f4;
}

QPushButton {
    min-height: 38px;
    padding: 6px 15px;
    color: #17344f;
    background-color: #ffffff;
    border: 1px solid #cbd3da;
    border-radius: 8px;
    font-weight: 650;
}

QPushButton:hover {
    color: #10263b;
    background-color: #edf1f4;
    border-color: #7b8794;
}

QPushButton:pressed {
    background-color: #dde3e8;
}

QPushButton:disabled {
    color: #7b8794;
    background-color: #edf1f4;
    border-color: #dde3e8;
}

QPushButton#botaoPrimario {
    color: #ffffff;
    background-color: #17344f;
    border-color: #17344f;
    font-weight: 700;
}

QPushButton#botaoPrimario:hover {
    background-color: #10263b;
    border-color: #10263b;
}

QPushButton#botaoSucesso {
    color: #ffffff;
    background-color: #176f6a;
    border-color: #176f6a;
    font-weight: 700;
}

QPushButton#botaoSucesso:hover {
    background-color: #125e5a;
    border-color: #125e5a;
}

QPushButton#botaoPerigo {
    color: #a93f46;
    background-color: #ffffff;
    border-color: #d5a2a6;
}

QPushButton#botaoPerigo:hover {
    color: #ffffff;
    background-color: #a93f46;
    border-color: #a93f46;
}

QGroupBox {
    margin-top: 13px;
    padding-top: 12px;
    color: #10263b;
    background-color: #ffffff;
    border: 1px solid #e8edf1;
    border-radius: 12px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 5px;
}

QTabWidget::pane {
    background-color: #f4f6f8;
    border: none;
}

QTabBar::tab {
    min-width: 105px;
    padding: 12px 16px;
    margin-right: 3px;
    color: rgba(255, 255, 255, 0.76);
    background-color: #10263b;
    border: none;
    font-weight: 600;
}

QTabBar::tab:first {
    border-top-left-radius: 8px;
}

QTabBar::tab:last {
    border-top-right-radius: 8px;
}

QTabBar::tab:hover {
    color: #ffffff;
    background-color: #17344f;
}

QTabBar::tab:selected {
    color: #ffffff;
    background-color: #176f6a;
    font-weight: 700;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #2c3946;
    min-width: 280px;
}

QToolTip {
    padding: 6px;
    color: #ffffff;
    background-color: #10263b;
    border: none;
}

QScrollBar:vertical {
    width: 10px;
    margin: 2px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #cbd3da;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #aeb9c3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

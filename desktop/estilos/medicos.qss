QWidget#paginaMedicos {
    background-color: #f4f6f8;
}

QLabel#tituloPagina {
    color: #10263b;
    font-size: 25px;
    font-weight: 800;
}

QLabel#subtituloPagina {
    color: #617080;
    font-size: 14px;
}

QFrame#medicoCard {
    background-color: #ffffff;
    border: 1px solid #e8edf1;
    border-radius: 14px;
}

QFrame#areaFotoMedico {
    background-color: #f6f8fa;
    border: 1px solid #e8edf1;
    border-radius: 10px;
}

QLabel#fotoMedico {
    color: #7b8794;
}

QLabel#badgeEspecialidade {
    padding: 5px 9px;
    color: #176f6a;
    background-color: #e7f3f1;
    border: 1px solid #b9ddda;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#nomeMedico {
    color: #10263b;
    font-size: 18px;
    font-weight: 800;
}

QLabel#especialidadeMedico {
    color: #176f6a;
    font-size: 14px;
    font-weight: 700;
}

QLabel#informacaoMedico,
QLabel#textoDisponibilidade {
    color: #617080;
    font-size: 13px;
}

QFrame#painelDisponibilidade {
    background-color: #f6f8fa;
    border: 1px solid #e8edf1;
    border-radius: 9px;
}

QPushButton#botaoAgendar,
QPushButton#botaoConfirmarConsulta {
    min-height: 44px;
    color: #ffffff;
    background-color: #176f6a;
    border-color: #176f6a;
    font-weight: 750;
}

QPushButton#botaoAgendar:hover,
QPushButton#botaoConfirmarConsulta:hover {
    background-color: #125e5a;
    border-color: #125e5a;
}

QDialog#dialogoAgendamento {
    background-color: #f4f6f8;
}

QLabel#nomeDialogoMedico {
    color: #10263b;
    font-size: 18px;
    font-weight: 800;
}

QLabel#especialidadeDialogo {
    color: #176f6a;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#botaoHorario:checked {
    color: #ffffff;
    background-color: #176f6a;
    border-color: #176f6a;
}

QLabel#mensagemVazia {
    color: #617080;
    font-size: 16px;
    padding: 45px;
}

QLabel#mensagemErro {
    color: #a93f46;
    font-size: 14px;
    padding: 35px;
}

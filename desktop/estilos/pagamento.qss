QDialog#dialogoFinalizar,
QDialog#dialogoPagamento {
    background-color: #f4f6f8;
}

QFrame#cardDialogo {
    background-color: #ffffff;
    border: 1px solid #e8edf1;
    border-radius: 13px;
}

QLabel#tituloDialogo {
    color: #10263b;
    font-size: 22px;
    font-weight: 800;
}

QLabel#subtituloDialogo {
    color: #617080;
}

QLabel#totalDialogo {
    color: #10263b;
    font-size: 22px;
    font-weight: 800;
}

QLabel#statusPagamento {
    padding: 8px 11px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 750;
}

QLabel#statusPagamento[tipoStatus="aprovado"] {
    color: #19553e;
    background-color: #eef8f3;
    border: 1px solid #b9ddcc;
}

QLabel#statusPagamento[tipoStatus="pendente"] {
    color: #765019;
    background-color: #fff7e8;
    border: 1px solid #ead3a7;
}

QLabel#statusPagamento[tipoStatus="falha"] {
    color: #7d2f35;
    background-color: #fbf0f1;
    border: 1px solid #e5bdc0;
}
